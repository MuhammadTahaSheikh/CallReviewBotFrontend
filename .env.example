# Supabase / Postgres
# Use the URI from Supabase → Project Settings → Database → Connection string
# URL-encode special characters in the password (e.g. $ -> %24)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Legacy anon JWT also works if you prefer:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Bootstrap admin email (always kept as admin)
ADMIN_EMAIL="you@company.com"

# Live xAI (required)
AI_MODE="live"
XAI_API_KEY="xai-..."
XAI_MODEL="grok-4.6"
XAI_BASE_URL="https://api.x.ai/v1"

# Optional model pricing estimates (USD per 1M tokens)
XAI_INPUT_PRICE_PER_1M="5"
XAI_OUTPUT_PRICE_PER_1M="15"

# Webhook shared secret (Phase 5)
WEBHOOK_SECRET="change-me-local-secret"
